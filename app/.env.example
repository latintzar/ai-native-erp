VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Google Maps browser key (Maps JavaScript + Static APIs, referrer-restricted, quota-capped). Unset = the checked-in tiles.
VITE_GOOGLE_MAPS_KEY=

# Optional installation-owned Zendesk Messaging snippet URL. Public widget ID, not a secret.
# Empty uses the project's GitHub issues; no original support account is loaded.
VITE_SUPPORT_WIDGET_URL=
