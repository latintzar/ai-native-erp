# Example only. Generate a private working file with: python -m runtime init
# The runner reads literal KEY=value lines; keep values unquoted.
COPPER_STATE_DIR=/absolute/private/path/to/copper-state
COPPER_PUBLIC_ORIGIN=http://127.0.0.1:8795
COPPER_ADMIN_TOKEN=GENERATED_BY_RUNTIME_INIT
COPPER_ENCRYPTION_KEY=GENERATED_BY_RUNTIME_INIT
COPPER_ALLOW_LIVE=0
# Optional exact additional frontend origins; separate multiple values with commas.
CEDAR_ALLOWED_ORIGINS=http://127.0.0.1:8094
# Prometeo and NubeFact credentials enter through the protected operator interface.
