  "stages": [
    {
      "id": "foundation",
      "title": "Foundation",
      "purpose": "Establish tenant-safe commands, event history, projections, and shared sheet behavior before domain writes."
    },
    {
      "id": "domain-records",
      "title": "Domain records",
      "purpose": "Implement durable product, customer, order, source, stock, money, and output records."
    },
    {
      "id": "sheet-ports",
      "title": "Sheet ports",
      "purpose": "Connect every named sheet control to its command/read model, exact copy, state, and recovery behavior."
    },
    {
      "id": "automation-services",
      "title": "Automation and services",
      "purpose": "Add bounded intelligence, image jobs, asynchronous output, and external adapters after source and command boundaries exist."
    },
    {
      "id": "administration-activation",
      "title": "Administration and activation",
      "purpose": "Complete settings, onboarding, billing, data lifecycle, and support controls for an operating tenant."
    },
    {
      "id": "assurance-release",
      "title": "Assurance and release",
      "purpose": "Prove security, accessibility, resilience, recovery, cutover, and release evidence before any production permission."
    }
  ],
